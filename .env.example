# jobscout configuration. Copy to `.env` and adjust.
# Every value below has a conservative default in code; this file documents
# the full surface. Never commit a real `.env`.

# --- Storage -------------------------------------------------------------
JOBSCOUT_DB_PATH=data/jobscout.sqlite3
JOBSCOUT_PROFILE_PATH=profile.example.yaml
# Maximum bytes kept for a single raw payload (larger payloads are recorded
# with metadata only, and the body is discarded). It is also the live search
# download ceiling, so an oversized search response is bounded in memory.
JOBSCOUT_RAW_MAX_BYTES=262144

# --- HTTP / collector ----------------------------------------------------
# Honest, non-spoofing user agent. Add a contact if you run this regularly.
JOBSCOUT_HTTP_USER_AGENT=jobscout/0.1 (local research tool)
JOBSCOUT_CONTACT_EMAIL=
JOBSCOUT_HTTP_TIMEOUT_SECONDS=20
JOBSCOUT_HTTP_MAX_RETRIES=2
# Conservative pacing. Requests are spaced by at least this interval.
JOBSCOUT_REQUEST_DELAY_SECONDS=8
JOBSCOUT_REQUEST_JITTER_SECONDS=2
# Bounded by default: two pages of 25 cards, at most 40 stored items.
# Absolute upper bounds: JOBSCOUT_MAX_PAGES <= 10, JOBSCOUT_MAX_ITEMS <= 250.
JOBSCOUT_MAX_PAGES=2
JOBSCOUT_MAX_ITEMS=40
# Keyword planning: comma-separated family ids shown by `jobscout keyword-plan`
# when no --family flag is passed. Leave unset to list every family in the
# catalog. An unknown id is rejected at startup.
# Known ids: junior-cloud, junior-devops, platform-engineer, cloud-security,
# devsecops, azure-cloud-security, azure-devsecops, iam-security-infra.
# JOBSCOUT_KEYWORD_FAMILIES=
# Must be https on linkedin.com or a *.linkedin.com host. Non-HTTPS schemes,
# unrelated hosts, and embedded credentials are rejected at startup.
JOBSCOUT_LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search

# --- Job-detail enrichment (opt-in, bounded) ------------------------------
# `fetch-details` is disabled unless --confirm-network (or an offline --fixture)
# is passed. {job_id} is replaced with the stored LinkedIn job id.
# Both LinkedIn URLs must be https on linkedin.com or a *.linkedin.com host;
# other hosts, file/ftp/data schemes, embedded credentials, and non-default
# ports are rejected at startup.
JOBSCOUT_LINKEDIN_DETAIL_URL=https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{job_id}
# Absolute upper bound: JOBSCOUT_DETAIL_MAX_ITEMS <= 250.
JOBSCOUT_DETAIL_MAX_ITEMS=20
JOBSCOUT_DETAIL_TIMEOUT_SECONDS=20
# Responses above this size are recorded as failures and never parsed/stored.
# A body above JOBSCOUT_RAW_MAX_BYTES is also never stored verbatim, whichever
# ceiling is lower.
JOBSCOUT_DETAIL_MAX_BYTES=524288

# --- GetManfred sitemap inventory (opt-in, bounded) -----------------------
# `search-getmanfred` is disabled unless --confirm-network is passed. It reads
# only the public offers sitemap advertised in GetManfred's robots.txt (which
# allows /). There is no keyword fan-out and no search rank; observed positions
# are stored as position_kind = none with rank 0.
# `--keywords` is optional and applied LOCALLY to the sitemap in one download:
# only offers whose normalized title/slug matches are kept, and each kept offer
# records the matched keyword(s) as provenance. No private endpoint, no
# per-keyword request.
# The URL must be https on getmanfred.com or a *.getmanfred.com host.
JOBSCOUT_GETMANFRED_SITEMAP_URL=https://www.getmanfred.com/sitemap-offers.xml
JOBSCOUT_GETMANFRED_OFFER_PATH_PREFIX=/ofertas-empleo/
# GetManfred's public robots.txt, re-fetched before the first detail request and
# enforced per URL. Must be https on getmanfred.com or a *.getmanfred.com host.
JOBSCOUT_GETMANFRED_ROBOTS_URL=https://www.getmanfred.com/robots.txt
# Bounded child-sitemap cap when the configured URL is a sitemap index.
# Absolute upper bound: JOBSCOUT_GETMANFRED_MAX_DOCUMENTS <= 10.
JOBSCOUT_GETMANFRED_MAX_DOCUMENTS=1
# Absolute upper bound: JOBSCOUT_GETMANFRED_MAX_ITEMS <= 250.
JOBSCOUT_GETMANFRED_MAX_ITEMS=40
# `fetch-getmanfred-details` (opt-in, bounded) enriches stored GetManfred offers
# from the recognized JobPosting JSON-LD on their public detail page. Disabled
# unless --confirm-network is passed; it re-fetches robots.txt before the first
# request. No login or cookies.
# Absolute upper bound: JOBSCOUT_GETMANFRED_DETAIL_MAX_ITEMS <= 250.
JOBSCOUT_GETMANFRED_DETAIL_MAX_ITEMS=20

# --- Tecnoempleo public search (opt-in, bounded) --------------------------
# `search-tecnoempleo` is disabled unless --confirm-network is passed. It uses
# Tecnoempleo's public server-rendered search only, re-fetches robots.txt before
# the first request, and fails closed if the path is disallowed. No login, no
# cookies, no private RSS, no unauthorized API.
# Both URLs must be https on tecnoempleo.com or a *.tecnoempleo.com host.
JOBSCOUT_TECNOEMPLEO_SEARCH_URL=https://www.tecnoempleo.com/ofertas-trabajo/
JOBSCOUT_TECNOEMPLEO_ROBOTS_URL=https://www.tecnoempleo.com/robots.txt
# Stable path fragment that identifies an offer detail link ("rf-<id>").
# NOTE: unverified against a live page; confirm before a live run.
JOBSCOUT_TECNOEMPLEO_OFFER_PATH_MARKER=rf-
# Absolute upper bounds: JOBSCOUT_TECNOEMPLEO_MAX_PAGES <= 10,
# JOBSCOUT_TECNOEMPLEO_MAX_ITEMS <= 250.
JOBSCOUT_TECNOEMPLEO_MAX_PAGES=2
JOBSCOUT_TECNOEMPLEO_MAX_ITEMS=40
# `fetch-tecnoempleo-details` (opt-in, bounded) enriches stored Tecnoempleo
# offers from their public detail page. Disabled unless --confirm-network is
# passed; it re-reads robots.txt before the first request. No login or cookies.
# Absolute upper bound: JOBSCOUT_TECNOEMPLEO_DETAIL_MAX_ITEMS <= 250.
JOBSCOUT_TECNOEMPLEO_DETAIL_MAX_ITEMS=20

# --- Local notifications (opt-in, disabled by default) -------------------
# `notify` is a manual, read-only preview. It never runs on a schedule, never
# uses the network, never writes SQLite, and never applies to an offer. It
# selects active offers that have a stored successful score at or above the
# threshold, optionally match the preference outcome, and have NO imported
# human feedback row at all.
JOBSCOUT_NOTIFY_ENABLED=false
# Finite number in 0..100. Comparison is inclusive (score >= threshold).
JOBSCOUT_NOTIFY_SCORE_THRESHOLD=80.0
# Optional preference filter: leave empty for no filter, or pass/flag/fail.
JOBSCOUT_NOTIFY_PREFERENCE_OUTCOME=
# Delivery channel. `stdout` always prints the preview. `system` is attempted
# only with an explicit `--deliver` and only if a local `notify-send` (Linux)
# or `terminal-notifier` (macOS) exists on PATH; otherwise it falls back to
# stdout. There is no remote delivery and no background service.
JOBSCOUT_NOTIFY_DELIVERY=stdout

# --- LLM scorer (optional) ----------------------------------------------
# The heuristic scorer needs none of this. Tests never need a key.
# JOBSCOUT_LLM_BASE_URL must be https with no embedded credentials; http/file
# and other local schemes are rejected so an API key is never sent in the clear.
JOBSCOUT_LLM_BASE_URL=
JOBSCOUT_LLM_API_KEY=
JOBSCOUT_LLM_MODEL=deepseek-v4.1-flash
JOBSCOUT_LLM_TIMEOUT_SECONDS=60
JOBSCOUT_LLM_MAX_RETRIES=2
JOBSCOUT_LLM_TEMPERATURE=0
JOBSCOUT_LLM_MAX_TOKENS=1200
# Store the raw model response only when it is small and credential-free.
JOBSCOUT_LLM_STORE_RAW=true
# Ask the endpoint for a JSON object response when it supports it.
JOBSCOUT_LLM_JSON_MODE=true

# --- OpenCode CLI scorer (default, no API key) ---------------------------
# Reuses the locally installed and authenticated `opencode` CLI. This path does
# not use JOBSCOUT_LLM_API_KEY for authentication; run `opencode auth login`
# once instead. If a key is configured, jobscout keeps it out of the CLI
# argument array and project files, removes it from the child environment, and
# redacts it from captured output before persistence.
# The executable is resolved only through an absolute path or PATH lookup; a
# relative path (or a planted binary in the working directory) is never used.
# Child output is bounded while the process runs and the child is terminated on
# overflow or timeout.
JOBSCOUT_OPENCODE_COMMAND=opencode
JOBSCOUT_OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# Isolate the CLI from your OpenCode plugins and config. OpenCode 2.x removed
# --pure, so this means `opencode run --standalone` with a private
# XDG_CONFIG_HOME next to the database (data/opencode-config). Plugins are
# arbitrary local code. Set to false only if you rely on a plugin.
JOBSCOUT_OPENCODE_PURE=true
# Reasoning-effort variant, sent as `--model <model>#<variant>` (OpenCode 2.x
# removed --variant). `low` keeps the reasoning budget small so the JSON object
# gets closed; `minimal` no longer exists for deepseek-v4.1-flash. Variants
# depend on the model: probe a new one by hand first. Empty omits the variant.
JOBSCOUT_OPENCODE_VARIANT=low
# Optional model for the rest of a `score` run after the first provider error,
# e.g. when a free model runs out. May carry its own `#variant`. Switching model
# re-scores offers gradually: the model is part of each input fingerprint.
# JOBSCOUT_OPENCODE_FALLBACK_MODEL=opencode-go/deepseek-v4.1-flash#low
JOBSCOUT_OPENCODE_TIMEOUT_SECONDS=180
# Working directory for the CLI. Left unset (or empty), it uses a private,
# empty directory next to the database (`<database folder>/opencode-work`)
# instead of a shared temp directory. Any other value sets an explicit path.
# JOBSCOUT_OPENCODE_WORKDIR=
# Captured CLI output is truncated above this many bytes before it is parsed or
# considered for raw storage.
JOBSCOUT_OPENCODE_MAX_OUTPUT_BYTES=1048576
# Pass --format json to get raw JSON events instead of formatted text.
JOBSCOUT_OPENCODE_JSON_EVENTS=true

# GetManfred's public offers sitemap is larger than JOBSCOUT_RAW_MAX_BYTES.
# This provider-only ceiling is bounded at 1 MiB and does not change the global limit.
JOBSCOUT_GETMANFRED_MAX_BYTES=1048576
# An incomplete JSON response (a valid prefix that never closes the object, as
# seen once on a live call with `reason=stop`) is recorded as `parse_error`. It
# is intentionally NOT retried automatically: a silent retry could mask a
# truncated answer or invite an invented score. Re-run the scorer explicitly for
# another attempt.
